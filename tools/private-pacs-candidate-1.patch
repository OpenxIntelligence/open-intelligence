index 0000000..99cc73d
--- /dev/null
+++ b/tools/imaging/h1_private_archive.py
@@ -0,0 +1,88 @@
+"""Isolated pydicom/PACS adapter for the H1 synthetic imaging experiment.
+
+Optional operator-injected adapter; the existing custody owner parses originals. The application sees a private Unix socket, never a PACS URL or
+end-user PACS token. This is not a general-purpose HTTP forwarding client.
+"""
+from contextlib import closing
+from email import policy
+from email.parser import BytesParser
+import http.client
+from io import BytesIO
+import os
+from pathlib import Path
+import re
+import socket
+import stat
+
+from oi_api.dicom_integrity import MAX_DICOM_BYTES as MAX_IMAGE_BYTES
+
+def dicom_uid(value):
+    if type(value) is not str or len(value)>64 or re.fullmatch(r"(?:0|[1-9][0-9]*)(?:\.(?:0|[1-9][0-9]*))+", value) is None:
+        raise ValueError("Invalid DICOM UID")
+
+WADO_ACCEPT = 'multipart/related; type="application/dicom"; transfer-syntax=1.2.840.10008.1.2.1'
+MAX_WIRE_BYTES = MAX_IMAGE_BYTES + 4096
+
+
+def dicom_part(media: str, wire: bytes) -> bytes:
+    if (type(media) is not str or len(media)>512 or '\r' in media or '\n' in media
+            or type(wire) is not bytes or len(wire)>MAX_WIRE_BYTES):
+        raise ValueError('Unsupported archive framing')
+    try:
+        header = ('Content-Type: '+media+'\r\nMIME-Version: 1.0\r\n\r\n').encode('ascii')
+    except UnicodeError:
+        raise ValueError('Unsupported archive media') from None
+    message=BytesParser(policy=policy.default).parsebytes(header+wire)
+    if (message.get_content_type()!='multipart/related' or not message.is_multipart()
+            or message.get_param('type')!='application/dicom' or message.defects
+            or message.preamble not in (None,'') or (message.epilogue or '').strip()):
+        raise ValueError('Invalid archive multipart')
+    parts=list(message.iter_parts())
+    if len(parts)!=1:
+        raise ValueError('Expected one exact DICOM instance')
+    part=parts[0]
+    if (part.is_multipart() or part.defects or len(part.get_all('Content-Type',[]))!=1
+            or part.get_content_type()!='application/dicom'
+            or part.get('Content-Transfer-Encoding','binary').lower()!='binary'):
+        raise ValueError('Invalid archive part')
+    data=part.get_payload(decode=True)
+    if (type(data) is not bytes or not 132<=len(data)<=MAX_IMAGE_BYTES or data[128:132]!=b'DICM'):
+        raise ValueError('Invalid bounded Part 10')
+    return data
+
+
+class _UnixHTTP(http.client.HTTPConnection):
+    def __init__(self,path:Path):
+        super().__init__('localhost',timeout=3)
+        self.path=path
+    def connect(self):
+        self.sock=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
+        self.sock.settimeout(self.timeout)
+        self.sock.connect(str(self.path))
+
+
+class PrivateUnixArchive:
+    def __init__(self,socket_path:str, *, archive_id:str='H1-SYNTHETIC-PACS'):
+        self.path=Path(socket_path)
+        self.archive_id=archive_id
+        if not self.path.is_absolute():
+            raise ValueError('Operator configured absolute socket required')
+
+    def read(self,study_uid:str,series_uid:str,sop_uid:str)->bytes:
+        for value in (study_uid,series_uid,sop_uid):
+            dicom_uid(value)
+        parent=self.path.parent.lstat();target=self.path.lstat()
+        if (not stat.S_ISDIR(parent.st_mode) or parent.st_uid!=os.geteuid()
+                or parent.st_mode & 0o077 or not stat.S_ISSOCK(target.st_mode)
+                or target.st_uid!=os.geteuid() or target.st_mode & 0o077):
+            raise RuntimeError('Private archive endpoint unavailable')
+        path=f'/wado/studies/{study_uid}/series/{series_uid}/instances/{sop_uid}'
+        with closing(_UnixHTTP(self.path)) as client:
+            client.request('GET',path,headers={'Accept':WADO_ACCEPT,'Connection':'close'})
