+name: H1 canonical image custody with private PACS (synthetic only)
+on:
+  pull_request:
+    paths:
+      - 'apps/api/**'
+      - 'tools/imaging/**'
+      - '.github/workflows/h1-private-pacs.yml'
+  workflow_dispatch:
+permissions:
+  contents: read
+concurrency:
+  group: h1-imaging-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+jobs:
+  verify:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    env:
+      PYTHONPATH: apps/api/src:src:.
+      PYTHONDONTWRITEBYTECODE: '1'
+      PIP_DISABLE_PIP_VERSION_CHECK: '1'
+      OI_API_ENVIRONMENT: synthetic
+      OI_API_RUN_DATABASE_TESTS: '1'
+      OI_API_DATABASE_URL: postgresql+pg8000://oi_api:oi_h1_synthetic_only@127.0.0.1:5432/oi_api_test_shell
+      OI_API_TEST_DATABASE_URL: postgresql+pg8000://oi_api:oi_h1_synthetic_only@127.0.0.1:5432/oi_api_test_shell
+      PACS_SOURCE_COMMIT: e9b4334477a66967d290add9e0b9afa068f59dc0
+      CARGO_INCREMENTAL: '0'
+      CARGO_BUILD_JOBS: '2'
+    services:
+      postgres:
+        image: postgres:16.15-bookworm
+        env:
+          POSTGRES_USER: oi_api
+          POSTGRES_PASSWORD: oi_h1_synthetic_only
+          POSTGRES_DB: oi_api_test_shell
+        ports: ['127.0.0.1:5432:5432']
+        options: >-
+          --health-cmd "pg_isready -U oi_api -d oi_api_test_shell"
+          --health-interval 2s --health-timeout 3s --health-retries 30
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
+        with:
+          ref: ${{ github.event.pull_request.head.sha || github.sha }}
+          persist-credentials: false
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12.16'
+      - name: Verify the exact proposed head and preserve source identity
+        env:
+          EXPECTED_HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
+        run: |
+          set -euo pipefail
+          python - <<'PYCODE'
+          import json,os,subprocess
+          from pathlib import Path
+          run=lambda *args:subprocess.check_output(args,text=True).strip()
+          assert run('git','rev-parse','HEAD')==os.environ['EXPECTED_HEAD']
+          spec={'commit_sha':run('git','rev-parse','HEAD'),'tree_sha':run('git','rev-parse','HEAD^{tree}')}
+          Path('verification-artifacts').mkdir(exist_ok=True)
+          Path('verification-artifacts/candidate.json').write_text(json.dumps(spec,indent=2))
+          subprocess.run(['git','archive','--format=zip','--output=verification-artifacts/source.zip',spec['tree_sha']],check=True)
+          print('Verified candidate source tree',spec['tree_sha'])
+          PYCODE
+          git diff --check
+      - name: Verify unchanged runtime wheels before installation
+        run: |
+          python tools/audit_ci_data_boundaries.py
+          python apps/api/tools/prepare_dependencies.py --wheel-dir /tmp/oi-h1-wheels
+          python apps/api/tools/check_dependencies.py --wheel-dir /tmp/oi-h1-wheels --sbom verification-artifacts/h1-runtime-sbom.json
+          python -m pip install --require-hashes --no-index --find-links /tmp/oi-h1-wheels -r apps/api/requirements.lock
+          python -m pip check
+      - name: Actual PostgreSQL contracts including denied image disclosure
+        run: |
+          set -euo pipefail
+          python -m oi_api.migrate upgrade head
+          python - <<'PY' 2>&1 | tee verification-artifacts/h1-api-tests.txt
+          import unittest
+          result=unittest.TextTestRunner(verbosity=2).run(unittest.defaultTestLoader.discover('apps/api/tests'))
+          assert result.wasSuccessful() and result.testsRun and not result.skipped, 'H1 tests failed or skipped'
+          PY
+          PYTHONPATH=src python -m unittest discover -s tests -v > verification-artifacts/reference-tests.txt 2>&1
+      - name: Compile the exact existing PACS candidate with standalone storage
+        run: |
+          set -euo pipefail
+          git init "$RUNNER_TEMP/pacs-source"
+          git -C "$RUNNER_TEMP/pacs-source" remote add origin https://github.com/knopkem/pacsnode.git
+          git -C "$RUNNER_TEMP/pacs-source" fetch --depth=1 origin "$PACS_SOURCE_COMMIT"
+          git -C "$RUNNER_TEMP/pacs-source" checkout --detach FETCH_HEAD
+          test "$(git -C "$RUNNER_TEMP/pacs-source" rev-parse HEAD)" = "$PACS_SOURCE_COMMIT"
+          cd "$RUNNER_TEMP/pacs-source"
+          grep -q 'licensed under the MIT License' NOTICE
+          grep -Eq 'license[[:space:]]*=[[:space:]]*"MIT"' Cargo.toml
+          sha256sum Cargo.lock > "$GITHUB_WORKSPACE/verification-artifacts/pacs-lock-sha256.txt"
+          rustc --version > "$GITHUB_WORKSPACE/verification-artifacts/rustc-version.txt"
+          cargo build --locked -p pacs-server --no-default-features --features standalone --bin pacsnode
+      - name: H1 PG16 and genuine private-PACS bytes, denial, restart and restore
+        env:
+          POSTGRES_CONTAINER: ${{ job.services.postgres.id }}
+        run: |
+          set -euo pipefail
+          python -m tools.imaging.verify_h1_private_pacs verify \
+            --binary "$RUNNER_TEMP/pacs-source/target/debug/pacsnode" \
+            --postgres-container "$POSTGRES_CONTAINER" \
+            --output verification-artifacts/h1-private-pacs.json 2>&1 | tee verification-artifacts/private-pacs-tests.txt
+      - name: Preserve bounded evidence and exact source, never keys or image payloads
+        if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: h1-private-imaging-${{ github.run_id }}-${{ github.run_attempt }}
+          path: verification-artifacts/
+          retention-days: 7
