+def main():
+    parser=argparse.ArgumentParser();parser.add_argument('mode',choices=['verify','serve'])
+    parser.add_argument('--binary',required=True);parser.add_argument('--directory')
+    parser.add_argument('--uid',type=int);parser.add_argument('--gid',type=int)
+    parser.add_argument('--postgres-container');parser.add_argument('--output',default='verification-artifacts/h1-private-pacs.json')
+    args=parser.parse_args()
+    if args.mode=='serve':
+        serve(args);return 0
+    evidence=dict(kind='oi.h1-private-pacs/1',upstream_commit=UPSTREAM,synthetic_only=True,
+        test_completed=False,clinical_approval=False,backend_adoption_approved=False,
+        production_identity_or_consent_verified=False,whole_host_sandbox_verified=False,
+        all_dicomweb_endpoints_enabled=False,upstream_rights_approved=False)
+    stage='host-port-check'
+    try:
+        if not direct_ports_closed():raise RuntimeError('Host already exposes an archive test port')
+        with tempfile.TemporaryDirectory(prefix='oi-private-pacs-') as directory:
+            root=Path(directory);os.chmod(root,0o700)
+            subprocess.run(['openssl','genpkey','-algorithm','RSA','-pkeyopt','rsa_keygen_bits:2048',
+                '-out',str(root/'private.pem')],check=True,capture_output=True)
+            os.chmod(root/'private.pem',0o600)
+            subprocess.run(['openssl','pkey','-in',str(root/'private.pem'),'-pubout',
+                '-out',str(root/'public.pem')],check=True,capture_output=True)
+            stage='private-namespace-startup'
+            proc=subprocess.Popen(['sudo','unshare','--net',sys.executable,str(Path(__file__).resolve()),
+                'serve','--binary',str(Path(args.binary).resolve()),'--directory',directory,
+                '--uid',str(os.getuid()),'--gid',str(os.getgid())],stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL,start_new_session=True)
+            try:
+                for _ in range(300):
+                    if (root/'ready.json').exists():break
+                    if proc.poll() is not None:raise RuntimeError('Private archive launcher stopped')
+                    time.sleep(.1)
+                else:raise RuntimeError('Private archive startup deadline')
+                ready=json.loads((root/'ready.json').read_text())
+                host=os.readlink('/proc/self/ns/net')
+                if ready['namespace']==host or ready['interfaces']!=['lo'] or ready['uid']!=os.getuid():
+                    raise RuntimeError('Archive network confinement missing')
+                if type(ready['pacs_pid']) is not int or ready['pacs_pid']<1:
+                    raise RuntimeError('Archive process identity missing')
+                kernel_namespace=subprocess.check_output(['sudo','readlink',f"/proc/{ready['pacs_pid']}/ns/net"],text=True).strip()
+                if kernel_namespace!=ready['namespace']:
+                    raise RuntimeError('PACS process namespace differs')
+                evidence.update(archive_namespace=ready['namespace'],api_namespace=host,
+                                archive_interfaces=ready['interfaces'],pacs_process_namespace_verified=True)
+                stage='actual-api-postgres-private-pacs'
+                evidence.update(acceptance(args,root,ready))
+            finally:
+                try:os.killpg(proc.pid,signal.SIGTERM)
+                except ProcessLookupError:pass
+                try:proc.wait(10)
+                except subprocess.TimeoutExpired:
+                    os.killpg(proc.pid,signal.SIGKILL);proc.wait()
+    except Exception as error:
+        evidence['failure_type']=type(error).__name__;evidence['test_completed']=False
+        evidence['failure_stage']=stage
+    output=Path(args.output);output.parent.mkdir(parents=True,exist_ok=True)
+    output.write_text(json.dumps(evidence,sort_keys=True,indent=2)+'\n')
+    print('H1 private PACS acceptance:', 'PASS' if evidence['test_completed'] else 'FAIL; see bounded receipt')
+    return 0 if evidence['test_completed'] else 1
+
+
+if __name__=='__main__':raise SystemExit(main())
