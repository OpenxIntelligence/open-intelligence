+def sign(key:Path,role:str)->str:
+    def b64(data):return base64.urlsafe_b64encode(data).rstrip(b'=').decode('ascii')
+    now=int(time.time())
+    claims=dict(iss=ISSUER,aud=AUDIENCE,sub='oi-private-service',iat=now-30,exp=now+900,
+                preferred_username='oi-private-service',roles=[role],modality_access=['CT'])
+    message='.'.join(b64(json.dumps(x,separators=(',',':'),sort_keys=True).encode())
+                     for x in ({'alg':'RS256','typ':'JWT'},claims))
+    signature=subprocess.run(['openssl','dgst','-sha256','-sign',str(key)],
+        input=message.encode('ascii'),capture_output=True,check=True).stdout
+    return message+'.'+b64(signature)
+
+
+def make_fixture(sop,index):
+    # The canonical owner's independently authored encoder, not a downloaded
+    # or package-provided DICOM example. Includes qualified issuer identity.
+    return image_bytes(study_uid=STUDY,series_uid=SERIES,sop_uid=sop,
+                       pixels=struct.pack('<4H',index,index+1,index+2,index+3))
+
+
+class NoRedirect(HTTPRedirectHandler):
+    def redirect_request(self,*args,**kwargs):raise RuntimeError('PACS redirect refused')
+
+
+def pacs_request(path,token,*,body=None,content_type=None):
+    headers={'Authorization':'Bearer '+token,'Accept':WADO_ACCEPT}
+    if content_type:headers['Content-Type']=content_type
+    req=Request('http://127.0.0.1:18042'+path,data=body,headers=headers)
+    try:r=build_opener(ProxyHandler({}),NoRedirect()).open(req,timeout=3)
+    except HTTPError as exc:
+        status=exc.code;exc.close();return status,'',b''
+    with r:
+        data=r.read(MAX_WIRE_BYTES+1)
+        if len(data)>MAX_WIRE_BYTES:raise RuntimeError('Archive bound exceeded')
+        return r.status,r.headers.get('Content-Type',''),data
+
+
+def serve(args):
+    root=Path(args.directory)
+    subprocess.run(['ip','link','set','lo','up'],check=True,capture_output=True)
+    interfaces=sorted(line.split(':',1)[0].strip() for line in Path('/proc/net/dev').read_text().splitlines()[2:] if ':' in line)
+    if interfaces!=['lo']:raise RuntimeError('Unexpected namespace interfaces')
+    namespace=os.readlink('/proc/self/ns/net')
+    # Privilege needed only to create the namespace, never to run the PACS/bridge.
+    if os.getuid()==0:
+        os.setgroups([]);os.setgid(args.gid);os.setuid(args.uid)
+    os.umask(0o077)
+    public=(root/'public.pem').read_text().strip()
+    config=f'''[server]
+http_port=18042
+dicom_port=11112
+storage_transfer_syntax="1.2.840.10008.1.2.1"
+[database]
+url="sqlite://./pacs.db"
+max_connections=5
+run_migrations=true
+[filesystem_storage]
+root="./blobs"
+[logging]
+level="error"
+format="json"
+[plugins]
+enabled=["basic-auth"]
+[plugins.basic-auth]
+mode="oidc"
+public_paths=["/health"]
+[plugins.basic-auth.oidc]
+issuer="{ISSUER}"
+audience="{AUDIENCE}"
+public_key_pem=\'\'\'{public}
+\'\'\'
+role_claim="roles"
+default_role="uploader"
+role_map={{oi_viewer="viewer",oi_uploader="uploader"}}
+attributes_claims=["modality_access"]
+'''
+    (root/'config.toml').write_text(config)
+    # Remove any inherited PACS overrides so this tested profile is the one used.
+    env={k:v for k,v in os.environ.items() if not k.startswith('PACS_')}
+    log=(root/'private-server.log').open('wb')
+    proc=subprocess.Popen([args.binary],cwd=root,env=env,stdout=log,stderr=log)
+    try:
+        for _ in range(100):
+            if proc.poll() is not None:raise RuntimeError('PACS startup failed')
+            try:
+                if pacs_request('/health','unused')[0]==200:break
+            except Exception:pass
+            time.sleep(.1)
+        else:raise RuntimeError('PACS readiness deadline')
+        uploader=sign(root/'private.pem','oi_uploader')
+        payloads=[make_fixture(sop,i) for i,sop in enumerate(SOPS,1)]
+        boundary=b'OIIndependentSyntheticUpload'
+        wire=b''.join(b'--'+boundary+b'\r\nContent-Type: application/dicom\r\n\r\n'+p+b'\r\n'
+                      for p in payloads)+b'--'+boundary+b'--\r\n'
+        status,_,_=pacs_request('/wado/studies',uploader,body=wire,
+           content_type='multipart/related; type="application/dicom"; boundary='+boundary.decode())
+        if status not in (200,201,202):raise RuntimeError('Synthetic upload failed')
+        viewer=sign(root/'private.pem','oi_viewer')
+        class Handler(BaseHTTPRequestHandler):
+            protocol_version='HTTP/1.1'
+            def log_message(self,*a):pass
+            def do_GET(self):
+                match=re.fullmatch(r'/wado/studies/([0-9.]+)/series/([0-9.]+)/instances/([0-9.]+)',self.path)
+                try:
+                    if not match:raise ValueError('Unexposed route')
+                    for uid in match.groups():dicom_uid(uid)
+                    status,media,body=pacs_request(self.path,viewer)
+                    if status!=200:media='application/octet-stream';body=b''
+                except Exception:status,media,body=502,'application/octet-stream',b''
+                self.send_response(status);self.send_header('Content-Type',media)
+                self.send_header('Content-Length',str(len(body)));self.send_header('Connection','close')
+                self.end_headers();self.wfile.write(body)
+            def do_POST(self):
+                self.send_response(405);self.send_header('Content-Length','0');self.end_headers()
+        with socketserver.ThreadingUnixStreamServer(str(root/'archive.sock'),Handler) as server:
+            os.chmod(root/'archive.sock',0o600)
+            (root/'ready.json').write_text(json.dumps(dict(namespace=namespace,interfaces=interfaces,
+                uid=os.getuid(),pacs_pid=proc.pid,original_sha256={s:sha256(b).hexdigest() for s,b in zip(SOPS,payloads)})))
+            server.serve_forever()
+    finally:
+        proc.terminate()
+        try:proc.wait(5)
+        except subprocess.TimeoutExpired:proc.kill();proc.wait()
+        log.close()
+
+
+def direct_ports_closed():
+    for port in (18042,11112):
+        try:
+            with socket.create_connection(('127.0.0.1',port),timeout=.3):
+                return False
+        except OSError:pass
+    return True
+
