+def acceptance(args,root,ready):
+    output={}
+    class RealAcceptance(fixture.SourceVersionFixture):
+        def test_private_archive(self):
+            for cred in self.creds:cred['actions']+=['image_import','image_read','image_original_read']
+            self.write()
+            adapter=PrivateUnixArchive(str(root/'archive.sock'))
+            def app(settings=None):return create_app(settings or self.settings,image_archive=adapter)
+            with running_server(app()) as base:
+                patient=self.setup_case(base)
+                beta=self.setup_case(base,token=TOKEN_B,case='CASE-BETA',key='CREATE-BETA',source_subject='SUBJECT-BETA')
+                code,source,_=self.ingest(base,patient,REPORT);self.assertEqual(code,201)
+                url=f'/v1/patients/{patient}/cases/CASE-ALPHA/sources/{source["source_id"]}/images'
+                bindings=[]
+                for index,sop in enumerate(SOPS,1):
+                    raw=make_fixture(sop,index)
+                    self.assertEqual(sha256(raw).hexdigest(),ready['original_sha256'][sop])
+                    code,receipt,_=image_request(base,url,raw=raw);self.assertEqual(code,201)
+                    bid=receipt['image_id'];bindings.append(bid)
+                    code,data,headers=get_image(base,url+'/'+bid);self.assertEqual(code,200)
+                    self.assertEqual(data,raw)
+                    self.assertRegex(headers['X-OI-Access-Receipt'],r'^ACCESS-[0-9A-F]{32}$')
+                    self.assertEqual(headers['Cache-Control'],'no-store')
+                self.assertTrue(direct_ports_closed())
+                self.assertEqual(get_image(base,url+'/'+bindings[0],TOKEN_B)[0],404)
+                self.assertEqual(get_image(base,f'/v1/patients/{beta}/cases/CASE-BETA/sources/{source["source_id"]}/images/'+bindings[0],TOKEN_B)[0],404)
+                self.creds[0]['actions'].remove('image_original_read');self.write()
+                self.assertEqual(get_image(base,url+'/'+bindings[0])[0],404)
+                self.creds[0]['actions'].append('image_original_read');self.write()
+                self.creds[0]['purpose']='research';self.write()
+                self.assertEqual(get_image(base,url+'/'+bindings[0])[0],404)
+                self.creds[0]['purpose']='operations';self.write()
+            with running_server(app()) as base:
+                self.assertEqual(get_image(base,url+'/'+bindings[0])[0],200)
+            # Exercise a real PostgreSQL service restart, then dump/restore the
+            # same image mappings + source history + canonical read events.
+            container=args.postgres_container
+            subprocess.run(['docker','restart',container],check=True,capture_output=True,timeout=45)
+            for _ in range(100):
+                test=subprocess.run(['docker','exec',container,'pg_isready','-U','oi_api'],capture_output=True)
+                if test.returncode==0:break
+                time.sleep(.1)
+            else:raise RuntimeError('PostgreSQL restart deadline')
+            with running_server(app()) as base:
+                self.assertEqual(get_image(base,url+'/'+bindings[0])[0],200)
+            dump=subprocess.run(['docker','exec',container,'pg_dump','-U','oi_api','--no-owner',
+                '--no-privileges','oi_api_test_shell'],capture_output=True,check=True).stdout
+            subprocess.run(['docker','exec',container,'createdb','-U','oi_api','oi_api_test_imaging_restore'],
+                capture_output=True,check=True)
+            try:
+                subprocess.run(['docker','exec','-i',container,'psql','-X','-v','ON_ERROR_STOP=1',
+                    '-U','oi_api','-d','oi_api_test_imaging_restore'],input=dump,capture_output=True,check=True)
+                target=make_url(self.settings.database_url).set(database='oi_api_test_imaging_restore').render_as_string(hide_password=False)
+                restored=replace(self.settings,database_url=target)
+                with running_server(app(restored)) as base:
+                    code,data,_=get_image(base,url+'/'+bindings[0]);self.assertEqual(code,200)
+                    self.assertEqual(sha256(data).hexdigest(),ready['original_sha256'][SOPS[0]])
+            finally:
+                subprocess.run(['docker','exec',container,'dropdb','-U','oi_api','oi_api_test_imaging_restore'],
+                    capture_output=True,check=True)
+            with running_server(app()) as base:
+                # This wrapper changes grants only AFTER a genuine private
+                # PACS roundtrip has completed, before owner publication.
+                original_read=adapter.read
+                def late_revoke(*ids):
+                    result=original_read(*ids)
+                    self.creds[0]['actions'].remove('image_original_read');self.write()
+                    return result
+                adapter.read=late_revoke
+                code,data,_=get_image(base,url+'/'+bindings[0]);self.assertEqual(code,404)
+                self.assertNotIn('DICM',str(data))
+                adapter.read=original_read
+                self.creds[0]['actions'].append('image_original_read');self.write()
+                def late_amend(*ids):
+                    result=original_read(*ids)
+                    self.assertEqual(self.ingest(base,patient,AMENDED)[0],201)
+                    return result
+                adapter.read=late_amend
+                self.assertEqual(get_image(base,url+'/'+bindings[0])[0],404)
+                adapter.read=original_read
+                self.assertEqual(get_image(base,url+'/'+bindings[0])[0],404)
+            with self.engine.begin() as c:
+                preserved=c.execute(text('SELECT count(*) FROM clinical_source.source_image_links')).scalar_one()
+                self.assertEqual(preserved,2)
+                events=c.execute(text("SELECT count(*) FROM identity.identity_domain_events WHERE event_type='image.original_read_authorized'")).scalar_one()
+            output.update(test_completed=True,object_count=2,original_hashes_verified=True,
+                opaque_bindings_preserved=preserved,read_receipt_events=events,
+                wrong_patient_denied=True,wrong_case_denied=True,purpose_mismatch_denied=True,
+                separate_imaging_grant_required=True,late_grant_revocation_denied=True,
+                late_source_amendment_denied=True,stale_bindings_denied=True,
+                api_restart_verified=True,database_restart_verified=True,dump_restore_verified=True,
+                direct_http_and_dimse_host_ports_blocked=direct_ports_closed())
+    RealAcceptance.setUpClass()
+    try:
+        result=unittest.TextTestRunner(verbosity=2).run(unittest.TestSuite([RealAcceptance('test_private_archive')]))
+        if not result.wasSuccessful() or result.skipped:raise RuntimeError('Actual H1 private PACS acceptance failed')
+    finally:RealAcceptance.tearDownClass()
+    return output
