+UPSTREAM='e9b4334477a66967d290add9e0b9afa068f59dc0'
+STUDY='2.25.110026110201000000000000000001'
+SERIES='2.25.110026110201000000000000000002'
+SOPS=('2.25.110026110201000000000000000003','2.25.110026110201000000000000000004')
+ISSUER='https://oi-fixture-issuer.example.invalid'
+AUDIENCE='oi-synthetic-pacs'
+
