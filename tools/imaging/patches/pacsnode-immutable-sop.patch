@@ -0,0 +1,286 @@
+//! Black-box regression contract for standalone immutable SOP storage.
+//! All payloads are independently authored test bytes; no patient objects.
+
+use std::{
+    fs,
+    path::Path,
+    process::{Child, Command, Stdio},
+    sync::Arc,
+    time::{Duration, Instant},
+};
+
+use bytes::Bytes;
+use pacs_core::{BlobStore, PacsError};
+use pacs_fs_storage::{FilesystemStorageConfig, FsBlobStore};
+use sha2::{Digest, Sha256};
+use tempfile::TempDir;
+use tokio::sync::Barrier;
+
+const KEY: &str = "1.2.3/4.5.6/7.8.9";
+const ORIGINAL: &[u8] = b"independently authored immutable original\0\x01\x02\xff";
+
+fn store_at(root: &Path) -> FsBlobStore {
+    FsBlobStore::new(&FilesystemStorageConfig {
+        root: root.to_string_lossy().into_owned(),
+    }).expect("filesystem store")
+}
+
+fn hash(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+#[tokio::test]
+async fn immutable_replay_and_conflict_preserve_original_across_fresh_store() {
+    let directory = TempDir::new().unwrap();
+    let store = store_at(directory.path());
+    store.put(KEY, Bytes::from_static(ORIGINAL)).await.unwrap();
+    let original_modified = fs::metadata(directory.path().join(KEY)).unwrap().modified().unwrap();
+    drop(store);
+
+    let reopened = store_at(directory.path());
+    reopened.put(KEY, Bytes::from_static(ORIGINAL)).await.unwrap();
+    assert_eq!(fs::metadata(directory.path().join(KEY)).unwrap().modified().unwrap(), original_modified);
+    assert!(matches!(reopened.put(KEY, Bytes::from_static(b"different bytes")).await,
+                     Err(PacsError::Conflict(_))));
+    let returned = reopened.get(KEY).await.unwrap();
+    assert_eq!(returned.as_ref(), ORIGINAL);
+    assert_eq!(hash(&returned), hash(ORIGINAL));
+}
+
+#[tokio::test]
+async fn immutable_sop_cannot_rebind_study_or_series_even_with_identical_bytes() {
+    let directory = TempDir::new().unwrap();
+    let store = store_at(directory.path());
+    store.put(KEY, Bytes::from_static(ORIGINAL)).await.unwrap();
+    for other_key in ["9.9/4.5.6/7.8.9", "1.2.3/9.8/7.8.9"] {
+        assert!(matches!(store.put(other_key, Bytes::from_static(ORIGINAL)).await,
+                         Err(PacsError::Conflict(_))));
+        assert!(!directory.path().join(other_key).exists());
+        assert!(matches!(store.get(other_key).await, Err(PacsError::NotFound { .. })));
+    }
+    assert_eq!(store.get(KEY).await.unwrap().as_ref(), ORIGINAL);
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn immutable_independent_stores_have_one_winner_for_concurrent_conflict() {
+    let directory = TempDir::new().unwrap();
+    let first = store_at(directory.path());
+    let second = store_at(directory.path());
+    let barrier = Arc::new(Barrier::new(2));
+    let first_barrier = barrier.clone();
+    let first_task = tokio::spawn(async move {
+        first_barrier.wait().await;
+        first.put(KEY, Bytes::from(vec![0x31; 512 * 1024])).await
+    });
+    let second_task = tokio::spawn(async move {
+        barrier.wait().await;
+        second.put(KEY, Bytes::from(vec![0x72; 512 * 1024])).await
+    });
+    let a = first_task.await.unwrap();
+    let b = second_task.await.unwrap();
+    let winner = match (a, b) {
+        (Ok(()), Err(PacsError::Conflict(_))) => 0x31,
+        (Err(PacsError::Conflict(_)), Ok(())) => 0x72,
+        other => panic!("exactly one independent writer must win: {other:?}"),
+    };
+    let reopened = store_at(directory.path());
+    let expected = vec![winner; 512 * 1024];
+    assert_eq!(reopened.get(KEY).await.unwrap().as_ref(), expected.as_slice());
+    assert_eq!(hash(&fs::read(directory.path().join(KEY)).unwrap()), hash(&expected));
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn immutable_concurrent_identical_writers_all_converge_without_replacement() {
+    let directory = TempDir::new().unwrap();
+    let barrier = Arc::new(Barrier::new(8));
+    let mut tasks = Vec::new();
+    for _ in 0..8 {
+        let store = store_at(directory.path());
+        let barrier = barrier.clone();
+        tasks.push(tokio::spawn(async move {
+            barrier.wait().await;
+            store.put(KEY, Bytes::from_static(ORIGINAL)).await
+        }));
+    }
+    for task in tasks {
+        task.await.unwrap().expect("identical concurrent replay");
+    }
+    assert_eq!(store_at(directory.path()).get(KEY).await.unwrap().as_ref(), ORIGINAL);
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn immutable_public_alias_never_exposes_a_partial_new_object() {
+    let directory = TempDir::new().unwrap();
+    let store = store_at(directory.path());
+    let payload = vec![0x5a; 8 * 1024 * 1024];
+    let expected_hash = hash(&payload);
+    let writer = tokio::spawn(async move { store.put(KEY, Bytes::from(payload)).await });
+    while !writer.is_finished() {
+        match fs::read(directory.path().join(KEY)) {
+            Ok(visible) => {
+                assert_eq!(visible.len(), 8 * 1024 * 1024);
+                assert_eq!(hash(&visible), expected_hash);
+            }
+            Err(error) => assert_eq!(error.kind(), std::io::ErrorKind::NotFound),
+        }
+        tokio::task::yield_now().await;
+    }
+    writer.await.unwrap().unwrap();
+    assert_eq!(hash(&fs::read(directory.path().join(KEY)).unwrap()), expected_hash);
+}
+
+#[tokio::test]
+async fn immutable_identical_retry_repairs_missing_alias_without_reassigning_claim() {
+    let directory = TempDir::new().unwrap();
+    let store = store_at(directory.path());
+    store.put(KEY, Bytes::from_static(ORIGINAL)).await.unwrap();
+    // Model an interrupted publication after durable claim creation, before
+    // the ordinary raw-DICOM alias is available. This is not a crash test.
+    fs::remove_file(directory.path().join(KEY)).unwrap();
+    drop(store);
+    let reopened = store_at(directory.path());
+    assert!(matches!(reopened.get(KEY).await, Err(PacsError::NotFound { .. })));
+    assert!(matches!(reopened.put(KEY, Bytes::from_static(b"conflicting retry")).await,
+                     Err(PacsError::Conflict(_))));
+    assert!(!directory.path().join(KEY).exists());
+    reopened.put(KEY, Bytes::from_static(ORIGINAL)).await.unwrap();
+    assert_eq!(reopened.get(KEY).await.unwrap().as_ref(), ORIGINAL);
+}
+
+#[tokio::test]
+async fn immutable_persisted_digest_detects_external_original_mutation() {
+    let directory = TempDir::new().unwrap();
+    let store = store_at(directory.path());
+    store.put(KEY, Bytes::from_static(ORIGINAL)).await.unwrap();
+    let mut mutated = ORIGINAL.to_vec();
+    mutated[0] ^= 1;
+    fs::write(directory.path().join(KEY), mutated).unwrap();
+    drop(store);
+    let reopened = store_at(directory.path());
+    assert!(matches!(reopened.get(KEY).await, Err(PacsError::Blob(_))));
+    assert!(matches!(reopened.put(KEY, Bytes::from_static(ORIGINAL)).await,
+                     Err(PacsError::Blob(_))));
+    assert!(reopened.exists(KEY).await.is_err());
+}
+
+#[tokio::test]
+async fn immutable_logical_delete_cannot_reuse_a_previously_claimed_sop() {
+    let directory = TempDir::new().unwrap();
+    let store = store_at(directory.path());
+    store.put(KEY, Bytes::from_static(ORIGINAL)).await.unwrap();
+    store.delete(KEY).await.unwrap();
+    assert!(!store.exists(KEY).await.unwrap());
+    drop(store);
+    let reopened = store_at(directory.path());
+    assert!(matches!(reopened.put(KEY, Bytes::from_static(b"reassigned UID")).await,
+                     Err(PacsError::Conflict(_))));
+    reopened.put(KEY, Bytes::from_static(ORIGINAL)).await.unwrap();
+    assert_eq!(reopened.get(KEY).await.unwrap().as_ref(), ORIGINAL);
+}
+
+#[test]
+fn immutable_legacy_unclaimed_archive_fails_closed_without_modifying_original() {
+    let directory = TempDir::new().unwrap();
+    let alias = directory.path().join(KEY);
+    fs::create_dir_all(alias.parent().unwrap()).unwrap();
+    fs::write(&alias, ORIGINAL).unwrap();
+    let result = FsBlobStore::new(&FilesystemStorageConfig {
+        root: directory.path().to_string_lossy().into_owned(),
+    });
+    assert!(result.is_err());
+    assert_eq!(fs::read(alias).unwrap(), ORIGINAL);
+}
+
+struct ChildGuard(Child);
+
+impl Drop for ChildGuard {
+    fn drop(&mut self) {
+        if self.0.try_wait().ok().flatten().is_none() {
+            let _ = self.0.kill();
+        }
+        let _ = self.0.wait();
+    }
+}
+
+fn wait_for_marker(path: &Path) {
+    let deadline = Instant::now() + Duration::from_secs(15);
+    while !path.exists() {
+        assert!(Instant::now() < deadline, "child synchronization timed out");
+        std::thread::sleep(Duration::from_millis(5));
+    }
+}
+
+fn wait_for_child(child: &mut ChildGuard) {
+    let deadline = Instant::now() + Duration::from_secs(15);
+    loop {
+        if let Some(status) = child.0.try_wait().unwrap() {
+            assert!(status.success(), "independent writer process failed: {status}");
+            return;
+        }
+        assert!(Instant::now() < deadline, "independent writer process timed out");
+        std::thread::sleep(Duration::from_millis(5));
+    }
+}
+
+// The parent test invokes this exact harness test in independent OS processes.
+// Ordinary suite discovery has no child environment and does no writer work.
+#[test]
+fn immutable_writer_process() {
+    let Ok(root) = std::env::var("PACS_IMMUTABLE_CHILD_ROOT") else { return; };
+    let coordination = std::env::var("PACS_IMMUTABLE_CHILD_COORDINATION").unwrap();
+    let name = std::env::var("PACS_IMMUTABLE_CHILD_NAME").unwrap();
+    let fill: u8 = std::env::var("PACS_IMMUTABLE_CHILD_FILL").unwrap().parse().unwrap();
+    let store = store_at(Path::new(&root));
+    let coordination = Path::new(&coordination);
+    fs::write(coordination.join(format!("ready-{name}")), b"ready").unwrap();
+    wait_for_marker(&coordination.join("release"));
+    let runtime = tokio::runtime::Runtime::new().unwrap();
+    let result = runtime.block_on(store.put(KEY, Bytes::from(vec![fill; 256 * 1024])));
+    let status = match result {
+        Ok(()) => "stored",
+        Err(PacsError::Conflict(_)) => "conflict",
+        Err(error) => panic!("unexpected child storage error: {error}"),
+    };
+    fs::write(coordination.join(format!("result-{name}")), status).unwrap();
+}
+
+#[tokio::test]
+async fn immutable_independent_processes_cannot_both_claim_conflicting_originals() {
+    let directory = TempDir::new().unwrap();
+    let root = directory.path().join("blobs");
+    drop(store_at(&root));
+    let executable = std::env::current_exe().unwrap();
+    let spawn = |name: &str, fill: u8| {
+        ChildGuard(Command::new(&executable)
+            .arg("--exact").arg("immutable_writer_process").arg("--nocapture")
+            .env("PACS_IMMUTABLE_CHILD_ROOT", &root)
+            .env("PACS_IMMUTABLE_CHILD_COORDINATION", directory.path())
+            .env("PACS_IMMUTABLE_CHILD_NAME", name)
+            .env("PACS_IMMUTABLE_CHILD_FILL", fill.to_string())
+            .stdout(Stdio::null()).stderr(Stdio::inherit()).spawn().unwrap())
+    };
+    let mut first = spawn("first", 0x31);
+    let mut second = spawn("second", 0x72);
+    wait_for_marker(&directory.path().join("ready-first"));
+    wait_for_marker(&directory.path().join("ready-second"));
+    fs::write(directory.path().join("release"), b"go").unwrap();
+    wait_for_child(&mut first);
+    wait_for_child(&mut second);
+    let first_status = fs::read_to_string(directory.path().join("result-first")).unwrap();
+    let second_status = fs::read_to_string(directory.path().join("result-second")).unwrap();
+    let winner = match (first_status.as_str(), second_status.as_str()) {
+        ("stored", "conflict") => 0x31,
+        ("conflict", "stored") => 0x72,
+        other => panic!("separate processes both claimed or both lost: {other:?}"),
+    };
+    let expected = vec![winner; 256 * 1024];
+    assert_eq!(store_at(&root).get(KEY).await.unwrap().as_ref(), expected.as_slice());
+    assert_eq!(hash(&fs::read(root.join(KEY)).unwrap()), hash(&expected));
+    // A third fresh process can replay the winning original without changing it.
+    let modified = fs::metadata(root.join(KEY)).unwrap().modified().unwrap();
+    let mut replay = spawn("replay", winner);
+    wait_for_child(&mut replay);
+    assert_eq!(fs::read_to_string(directory.path().join("result-replay")).unwrap(), "stored");
+    assert_eq!(fs::metadata(root.join(KEY)).unwrap().modified().unwrap(), modified);
+    assert_eq!(store_at(&root).get(KEY).await.unwrap().as_ref(), expected.as_slice());
+}
