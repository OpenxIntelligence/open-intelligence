--- /dev/null
+++ b/crates/pacs-fs-storage/src/immutable.rs
@@ -0,0 +1,290 @@
+//! Immutable, process-safe SOP publication for the standalone filesystem store.
+//!
+//! A completed object and its integrity record are staged before an atomic
+//! no-replace hard link claims the SOP UID. Composite-key aliases are published
+//! only from that claim. This is local-filesystem behavior, not an S3 contract.
+//! Directory/file syncing is deliberate, but is not a tested power-loss or
+//! backup-recovery guarantee. An interrupted pre-claim write can leave an orphan.
+
+use std::{
+    fs::{self, File, OpenOptions},
+    io::{self, Write},
+    path::{Path, PathBuf},
+};
+
+use bytes::Bytes;
+use pacs_core::{PacsError, PacsResult};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+
+const INTERNAL: &str = ".pacs-immutable-v1";
+const MAX_CLAIM_BYTES: u64 = 4096;
+
+#[derive(Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Claim {
+    version: u32,
+    sop_uid: String,
+    key: String,
+    byte_length: u64,
+    sha256: String,
+    object_directory: String,
+}
+
+fn invalid_data(message: &'static str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, message)
+}
+
+fn storage_error(error: io::Error) -> PacsError {
+    PacsError::Blob(Box::new(error))
+}
+
+fn missing(key: &str) -> PacsError {
+    PacsError::NotFound {
+        resource: "blob",
+        uid: key.to_string(),
+    }
+}
+
+fn conflict() -> PacsError {
+    PacsError::Conflict("SOP UID already owns different bytes or parent identifiers".into())
+}
+
+fn digest(data: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(data))
+}
+
+fn sync_directory(path: &Path) -> io::Result<()> {
+    File::open(path)?.sync_all()
+}
+
+/// Enable only an empty root or an already initialized immutable layout.
+/// Existing unclaimed archives require an explicit, separately validated
+/// migration; starting this backend must never silently reinterpret them.
+pub(crate) fn initialize(root: &Path) -> io::Result<()> {
+    let internal = root.join(INTERNAL);
+    match fs::symlink_metadata(&internal) {
+        Ok(meta) if meta.file_type().is_dir() => {}
+        Ok(_) => return Err(invalid_data("immutable storage directory is not a directory")),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {
+            for entry in fs::read_dir(root)? {
+                if entry?.file_name() != INTERNAL {
+                    // A separate process may have initialized this layout and
+                    // published a complete alias since our first metadata read.
+                    // Such an alias cannot precede its initialized claim store.
+                    let initialized = [&internal, &internal.join("objects"), &internal.join("claims")]
+                        .iter().all(|path| fs::symlink_metadata(path)
+                            .map(|meta| meta.file_type().is_dir()).unwrap_or(false));
+                    if !initialized {
+                        return Err(invalid_data("legacy unclaimed blob root requires explicit migration"));
+                    }
+                    break;
+                }
+            }
+        }
+        Err(error) => return Err(error),
+    }
+    for path in [internal.clone(), internal.join("objects"), internal.join("claims")] {
+        fs::create_dir_all(&path)?;
+        if !fs::symlink_metadata(&path)?.file_type().is_dir() {
+            return Err(invalid_data("immutable storage path must not be a symlink"));
+        }
+    }
+    sync_directory(&internal)?;
+    sync_directory(root)
+}
+
+fn key_parts(key: &str) -> PacsResult<[&str; 3]> {
+    let parts: Vec<_> = key.split('/').collect();
+    if parts.len() != 3 || parts.iter().any(|part| {
+        part.is_empty() || part.len() > 64
+            || !part.bytes().all(|byte| byte.is_ascii_digit() || byte == b'.')
+            || part.split('.').any(str::is_empty)
+    }) {
+        return Err(PacsError::InvalidRequest(
+            "filesystem blob key must contain three safe DICOM UIDs".into(),
+        ));
+    }
+    Ok([parts[0], parts[1], parts[2]])
+}
+
+pub(crate) fn alias_path(root: &Path, key: &str) -> PacsResult<PathBuf> {
+    let [study, series, sop] = key_parts(key)?;
+    Ok(root.join(study).join(series).join(sop))
+}
+
+fn claim_path(root: &Path, sop: &str) -> PathBuf {
+    root.join(INTERNAL).join("claims").join(format!("{sop}.json"))
+}
+
+fn object_path(root: &Path, claim: &Claim) -> PathBuf {
+    root.join(INTERNAL).join("objects")
+        .join(&claim.object_directory).join("object.dcm")
+}
+
+fn read_claim(root: &Path, sop: &str) -> PacsResult<Option<(Claim, Bytes)>> {
+    let path = claim_path(root, sop);
+    let metadata = match fs::symlink_metadata(&path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(storage_error(error)),
+    };
+    if !metadata.file_type().is_file() || metadata.len() > MAX_CLAIM_BYTES {
+        return Err(storage_error(invalid_data("invalid immutable SOP claim file")));
+    }
+    let encoded = fs::read(&path).map_err(storage_error)?;
+    let claim: Claim = serde_json::from_slice(&encoded)
+        .map_err(|_| storage_error(invalid_data("invalid immutable SOP claim")))?;
+    let parts = key_parts(&claim.key)
+        .map_err(|_| storage_error(invalid_data("invalid immutable SOP claim key")))?;
+    if claim.version != 1 || claim.sop_uid != sop || parts[2] != sop
+        || !claim.object_directory.starts_with("object-")
+        || !claim.object_directory.bytes().all(|byte| byte.is_ascii_alphanumeric() || byte == b'-')
+        || claim.sha256.len() != 64
+        || !claim.sha256.bytes().all(|byte| byte.is_ascii_hexdigit())
+    {
+        return Err(storage_error(invalid_data("invalid immutable SOP claim identity")));
+    }
+    let original = object_path(root, &claim);
+    if !fs::symlink_metadata(&original).map_err(storage_error)?.file_type().is_file() {
+        return Err(storage_error(invalid_data("immutable object is not a regular file")));
+    }
+    let bytes = fs::read(original).map_err(storage_error)?;
+    if bytes.len() as u64 != claim.byte_length || digest(&bytes) != claim.sha256 {
+        return Err(storage_error(invalid_data("immutable original failed persisted integrity check")));
+    }
+    Ok(Some((claim, Bytes::from(bytes))))
+}
+
+fn publish_alias(root: &Path, key: &str, claim: &Claim, original: &[u8]) -> PacsResult<()> {
+    let alias = alias_path(root, key)?;
+    let parent = alias.parent().expect("validated three-component key");
+    fs::create_dir_all(parent).map_err(storage_error)?;
+    match fs::hard_link(object_path(root, claim), &alias) {
+        Ok(()) => sync_directory(parent).map_err(storage_error),
+        Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {
+            if !fs::symlink_metadata(&alias).map_err(storage_error)?.file_type().is_file()
+                || fs::read(alias).map_err(storage_error)?.as_slice() != original
+            {
+                return Err(storage_error(invalid_data("existing blob alias differs from immutable original")));
+            }
+            Ok(())
+        }
+        Err(error) => Err(storage_error(error)),
+    }
+}
+
+fn accept_existing(root: &Path, key: &str, data: &[u8], claim: Claim, original: Bytes) -> PacsResult<()> {
+    if claim.key != key || original.as_ref() != data {
+        return Err(conflict());
+    }
+    // An identical retry may finish alias publication after interruption. It
+    // cannot replace a mismatching alias or erase the permanent original claim.
+    publish_alias(root, key, &claim, &original)
+}
+
+pub(crate) fn put(root: &Path, key: &str, data: &[u8]) -> PacsResult<()> {
+    let [_, _, sop] = key_parts(key)?;
+    if let Some((claim, original)) = read_claim(root, sop)? {
+        return accept_existing(root, key, data, claim, original);
+    }
+    let alias = alias_path(root, key)?;
+    match fs::symlink_metadata(&alias) {
+        Ok(_) => {
+            // Another writer may have just published both its claim and alias.
+            if let Some((claim, original)) = read_claim(root, sop)? {
+                return accept_existing(root, key, data, claim, original);
+            }
+            return Err(storage_error(invalid_data("existing blob has no immutable claim")));
+        }
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+        Err(error) => return Err(storage_error(error)),
+    }
+
+    let objects = root.join(INTERNAL).join("objects");
+    let staging = tempfile::Builder::new().prefix("object-")
+        .tempdir_in(&objects).map_err(storage_error)?;
+    let original_path = staging.path().join("object.dcm");
+    let mut original = OpenOptions::new().write(true).create_new(true)
+        .open(&original_path).map_err(storage_error)?;
+    original.write_all(data).map_err(storage_error)?;
+    original.sync_all().map_err(storage_error)?;
+    drop(original);
+    let claim = Claim {
+        version: 1,
+        sop_uid: sop.to_string(),
+        key: key.to_string(),
+        byte_length: data.len() as u64,
+        sha256: digest(data),
+        object_directory: staging.path().file_name().expect("temporary object directory")
+            .to_string_lossy().into_owned(),
+    };
+    let encoded = serde_json::to_vec(&claim)
+        .map_err(|_| storage_error(invalid_data("could not encode immutable SOP claim")))?;
+    let staged_claim = staging.path().join("claim.json");
+    let mut claim_file = OpenOptions::new().write(true).create_new(true)
+        .open(&staged_claim).map_err(storage_error)?;
+    claim_file.write_all(&encoded).map_err(storage_error)?;
+    claim_file.sync_all().map_err(storage_error)?;
+    drop(claim_file);
+    sync_directory(staging.path()).map_err(storage_error)?;
+
+    // Keep the complete object BEFORE publishing a claim to it. Cancellation
+    // or an error after this point must never run a tempdir destructor on a
+    // published winner. Only a writer whose no-replace link failed removes its
+    // own unique staging directory; it cannot remove another writer's object.
+    let owned_staging = staging.keep();
+    sync_directory(&objects).map_err(storage_error)?;
+    match fs::hard_link(&staged_claim, claim_path(root, sop)) {
+        Ok(()) => {
+            sync_directory(&root.join(INTERNAL).join("claims")).map_err(storage_error)?;
+            publish_alias(root, key, &claim, data)
+        }
+        Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {
+            fs::remove_dir_all(&owned_staging).map_err(storage_error)?;
+            let (winner, original) = read_claim(root, sop)?
+                .ok_or_else(|| storage_error(invalid_data("published SOP claim disappeared")))?;
+            accept_existing(root, key, data, winner, original)
+        }
+        Err(error) => {
+            let _ = fs::remove_dir_all(&owned_staging);
+            Err(storage_error(error))
+        }
+    }
+}
+
+pub(crate) fn get(root: &Path, key: &str) -> PacsResult<Bytes> {
+    let [_, _, sop] = key_parts(key)?;
+    let (claim, original) = read_claim(root, sop)?.ok_or_else(|| missing(key))?;
+    if claim.key != key {
+        return Err(missing(key));
+    }
+    let alias = alias_path(root, key)?;
+    let metadata = fs::symlink_metadata(&alias).map_err(|error| {
+        if error.kind() == io::ErrorKind::NotFound { missing(key) } else { storage_error(error) }
+    })?;
+    if !metadata.file_type().is_file() {
+        return Err(storage_error(invalid_data("blob alias is not a regular file")));
+    }
+    let visible = fs::read(alias).map_err(storage_error)?;
+    if visible.as_slice() != original.as_ref() {
+        return Err(storage_error(invalid_data("blob alias failed immutable original comparison")));
+    }
+    Ok(original)
+}
+
+pub(crate) fn delete(root: &Path, key: &str) -> PacsResult<()> {
+    match get(root, key) {
+        Ok(_) => {}
+        Err(PacsError::NotFound { .. }) => return Ok(()),
+        Err(error) => return Err(error),
+    }
+    let alias = alias_path(root, key)?;
+    match fs::remove_file(&alias) {
+        Ok(()) => sync_directory(alias.parent().expect("validated key")).map_err(storage_error),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(()),
+        Err(error) => Err(storage_error(error)),
+    }
+    // The immutable claim and original deliberately survive logical deletion.
+    // A previously used SOP UID cannot be reassigned to different bytes.
+}
