+async fn write_instance(connection: &mut sqlx::SqliteConnection, instance: &Instance) -> PacsResult<()> {
+    // The unique constraint and conditional statement are one SQLite write
+    // operation, so independent connections cannot race a read/check/write
+    // into replacing an existing instance or moving its hierarchy.
+    let result = sqlx::query(
+        r#"
+        INSERT INTO instances (
+            instance_uid, series_uid, study_uid, sop_class_uid, instance_number,
+            transfer_syntax, rows, columns, blob_key, metadata, created_at
+        )
+        SELECT ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, STRFTIME('%Y-%m-%dT%H:%M:%fZ', 'now')
+        WHERE EXISTS (SELECT 1 FROM series WHERE series_uid = ? AND study_uid = ?)
+        ON CONFLICT(instance_uid) DO UPDATE SET
+            instance_uid = instances.instance_uid
+        WHERE instances.series_uid = excluded.series_uid
+          AND instances.study_uid = excluded.study_uid
+          AND instances.blob_key = excluded.blob_key
+          AND instances.sop_class_uid IS excluded.sop_class_uid
+          AND instances.instance_number IS excluded.instance_number
+          AND instances.transfer_syntax IS excluded.transfer_syntax
+          AND instances.rows IS excluded.rows
+          AND instances.columns IS excluded.columns
+          AND instances.metadata = excluded.metadata
+        "#,
+    )
+    .bind(instance.instance_uid.as_ref())
+    .bind(instance.series_uid.as_ref())
+    .bind(instance.study_uid.as_ref())
+    .bind(instance.sop_class_uid.as_deref())
+    .bind(instance.instance_number)
+    .bind(instance.transfer_syntax.as_deref())
+    .bind(instance.rows)
+    .bind(instance.columns)
+    .bind(instance.blob_key.as_str())
+    .bind(Json(instance.metadata.as_value().clone()))
+    .bind(instance.series_uid.as_ref())
+    .bind(instance.study_uid.as_ref())
+    .execute(&mut *connection)
+    .await
+    .map_err(map_store_err)?;
+
+    if result.rows_affected() == 0 {
+        return Err(PacsError::Conflict(
+            "SOP instance metadata or parent identity conflicts with the stored object".into(),
+        ));
+    }
+
+    Ok(())
+}
