      "treatment purpose": {"bytes": "oi017-encounter-inst-a.txt", "purpose": "treatment", "expected": "raises, nothing imported (see test_treatment_purpose_and_expired_receipt_rejected)"},
      "after expiry": {"bytes": "oi017-encounter-inst-a.txt", "retrieved_at": "2027-01-05", "expires_at": "2026-12-31", "expected": "raises, nothing imported (see test_treatment_purpose_and_expired_receipt_rejected)"},
      "retrieved before issued": {"bytes": "oi017-encounter-inst-a.txt (issued 2026-01-13)", "retrieved_at": "2026-01-10", "expected": "raises, nothing imported (see test_time_semantics_retrieved_before_issued_rejected)"},
